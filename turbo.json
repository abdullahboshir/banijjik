{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@banijjik/lint-tests#test": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "TEST_REDIS_URL", "MONGOMS_*", "VITEST_MAX_WORKERS"]
    }
  }
}
