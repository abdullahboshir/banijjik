{
  "name": "@banijjik/web-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@banijjik/contracts": "*",
    "@banijjik/i18n": "*",
    "@banijjik/ui": "*",
    "@banijjik/validation": "*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "next": "^16.4.2",
    "react": "^19.3.0"
  },
  "peerDependencies": {
    "next": "^16.4.2",
    "react": "^19.0.0"
  }
}
