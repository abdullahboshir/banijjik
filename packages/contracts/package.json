{
  "name": "@banijjik/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./file": {
      "types": "./dist/file/index.d.ts",
      "default": "./dist/file/index.js"
    },
    "./contact": {
      "types": "./dist/contact/index.d.ts",
      "default": "./dist/contact/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./iam": {
      "types": "./dist/iam/index.d.ts",
      "default": "./dist/iam/index.js"
    },
    "./accounting": {
      "types": "./dist/accounting/index.d.ts",
      "default": "./dist/accounting/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "default": "./dist/pricing/index.js"
    },
    "./inventory": {
      "types": "./dist/inventory/index.d.ts",
      "default": "./dist/inventory/index.js"
    },
    "./directory": {
      "types": "./dist/directory/index.d.ts",
      "default": "./dist/directory/index.js"
    },
    "./booking": {
      "types": "./dist/booking/index.d.ts",
      "default": "./dist/booking/index.js"
    },
    "./credit": {
      "types": "./dist/credit/index.d.ts",
      "default": "./dist/credit/index.js"
    },
    "./payment": {
      "types": "./dist/payment/index.d.ts",
      "default": "./dist/payment/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src"
  }
}
