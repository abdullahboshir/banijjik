{
  "extends": "@banijjik/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": false,
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "app",
    "src",
    "next.config.ts",
    "proxy.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts"
  ]
}
