{
  "name": "@banijjik/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-industry-template-seeds.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config src/test-support/vitest.config.ts",
    "config:check": "tsx src/check-config.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "seed:platform-admin": "tsx src/seeds/run-seed-platform-admin.ts",
    "seed:packages": "tsx src/seeds/run-seed-packages.ts",
    "seed:industry-templates": "tsx src/seeds/run-seed-industry-templates.ts",
    "db:sync-indexes": "tsx src/seeds/run-sync-indexes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@banijjik/contracts": "*",
    "@banijjik/i18n": "*",
    "@banijjik/ids": "*",
    "@banijjik/validation": "*",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.3.12",
    "busboy": "^1.6.0",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mongoose": "^9.11.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.0.0"
  }
}
