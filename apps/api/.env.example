# Local development values only. Copy to apps/api/.env (git-ignored). Never put real secrets here.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# api = HTTP server, worker = background process (no HTTP)
ROLE=api
# DB_TENANT_SHARED_URL must use the same hosts, credentials and options as DB_PLATFORM_URL (only the platform URL connects) and a different database.
DB_PLATFORM_URL=mongodb://127.0.0.1:27018/banijjik_platform?replicaSet=rs0&directConnection=true
DB_TENANT_SHARED_URL=mongodb://127.0.0.1:27018/banijjik_tenant_shared?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6380
# Both dev apps: the admin app on 3000, the platform app on 3200.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3200
# Reverse proxies in front of the API. 0 = none (X-Forwarded-For is ignored). In production set it to the real count, e.g. 1 behind one load balancer.
TRUSTED_PROXY_HOPS=0
# Signs access tokens. Use a long random value of your own; this one is only a placeholder, and production refuses it (and any value containing "change-me").
AUTH_ACCESS_TOKEN_SECRET=change-me-local-only-placeholder-0123456789abcdef
# Optional: seed a platform super admin with `npm run seed:platform-admin -w @banijjik/api` (both or neither).
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# Uploaded files (card 3.0). Development stores them in a temp folder; production needs s3 (any S3-compatible service).
# FILE_STORAGE_DRIVER=local
# FILE_STORAGE_LOCAL_PATH=
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=
# FILE_STORAGE_S3_ENDPOINT=
# FILE_STORAGE_S3_ACCESS_KEY_ID=
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=
# Customer sign-in on the public site (card M.1). Development works with the defaults; production needs all three.
# OTP_SECRET seals and hashes one-time codes: at least 32 random characters, never the placeholder.
# OTP_SECRET=
# SMS_DRIVER: test-inbox (development and tests only; writes messages to a collection) or disabled (sends nothing and keeps
# customer sign-in off). Production refuses test-inbox; a real provider adapter comes with the matrimony track.
# SMS_DRIVER=test-inbox
# STOREFRONT_BASE_DOMAIN: a business's public site is <slug>.<this domain>. Development default: localhost.
# STOREFRONT_BASE_DOMAIN=sites.example.com
# Optional: how often the worker polls the outbox, in ms (default 500).
# OUTBOX_POLL_INTERVAL_MS=500

# SMS gateway credentials are entered in settings; this key seals them at rest.
CREDENTIALS_ENCRYPTION_KEY=
SMS_ADAREACH_BASE_URL=https://api.mobireach.com.bd
SMS_BULKSMSBD_BASE_URL=https://bulksmsbd.net/api
