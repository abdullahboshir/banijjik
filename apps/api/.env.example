# Local development values only. Copy to apps/api/.env (git-ignored). Never put real secrets here.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# api = HTTP server, worker = background process (no HTTP)
ROLE=api
# DB_TENANT_SHARED_URL must use the same hosts, credentials and options as DB_PLATFORM_URL (only the platform URL connects) and a different database.
DB_PLATFORM_URL=mongodb://127.0.0.1:27018/banijjik_platform?replicaSet=rs0&directConnection=true
DB_TENANT_SHARED_URL=mongodb://127.0.0.1:27018/banijjik_tenant_shared?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Signs access tokens. Use a long random value of your own; this one is only a placeholder.
AUTH_ACCESS_TOKEN_SECRET=change-me-local-only-placeholder-0123456789abcdef
# Optional: seed a platform super admin with `npm run seed:platform-admin -w @banijjik/api` (both or neither).
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
